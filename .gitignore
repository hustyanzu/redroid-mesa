# Build / fetch caches
/out/
/third_party/

# Runtime Android /data volumes (never commit)
/data/
/compose/data/
/compose/data-*/

# Extra download cache (also under third_party/)
/third_party/downloads/

# Python
__pycache__/
*.py[cod]
*$py.class

# Local env / secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
*.tmp

# Compiled leftovers
*.o
*.a
*.so
*.so.*
!patches/**

# Logs
*.log

# Local SuperSU / misc download scratch
/dl/
