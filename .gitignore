# Build / fetch caches
/out/

# third_party: vendored trees (e.g. supersu/) are committed;
# ignore NDK / Mesa checkout / download cache only.
/third_party/ndk/
/third_party/mesa/
/third_party/downloads/

# Runtime Android /data volumes (never commit)
/data/
/compose/data/
/compose/data-*/

# Python
__pycache__/
*.py[cod]
*$py.class

# Local env / secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
*.tmp

# Compiled leftovers
*.o
*.a
*.so
*.so.*
!patches/**

# Logs
*.log

# Local SuperSU / misc download scratch
/dl/

# Local scratch (screenshots etc.)
/temp/
