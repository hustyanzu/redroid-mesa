# Mesa + houdini + SuperSU switcher (default Root OFF). Tag: a13-supersu-<mesa>
# (houdini implied — same naming style as a13-magisk / a13-mindthegapps)
VARIANT_ID=a13-supersu
BASE_IMAGE=docker.io/redroid/redroid:13.0.0-latest
MESA_TAG=mesa-26.1.5
ANDROID_API=33
IMAGE_NAME=redroid-mesa
FEATURES=houdini,supersu
