# Pre-patched services.jar (+ oat) for CI / offline builds. Regenerate when
# BASE_IMAGE or FlagSecurePatcher version changes (see README).
BASE_IMAGE=docker.io/redroid/redroid:13.0.0-latest
FLAGSECURE_VERSION=r17
PATCH=isSecureLocked:RET_FALSE
OAT_ISA=x86_64
SERVICES_JAR_MD5=9a6aa2ff51d790a129e64870fab8f0f7
